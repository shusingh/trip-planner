# Your GROQ Inference API token
# Get one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_token_here

# Groq model to use (defaults to llama-3.3-70b-versatile if omitted).
# If Groq decommissions a model, override it here without a code change.
# Current models: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# Port your Go server listens on (defaults to 8080 if omitted)
PORT=8080